# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Saída de render do Remotion e artefatos gerados por episódio
/out
public/episodes/*/words.json
public/episodes/*/timeline.json

# Virtualenv Python para scripts/transcribe.py
/.venv

# Variáveis de ambiente locais (podem ter chaves)
.env
